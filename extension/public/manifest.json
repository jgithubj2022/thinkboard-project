{
  "manifest_version": 3,
  "name": "Thinkboard Notes",
  "version": "1.0.2",
  "description": "Access Thinkboard notes from any webpage",

  
  "permissions": [
    "activeTab",
    "scripting"
  ],

  "action": {
    "default_title": "Toggle Thinkboard Notes"
  },

  "host_permissions": [
    "http://localhost:5001/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
